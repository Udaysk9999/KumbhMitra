# AI KumbhMitra - Monorepo Root Environment Configuration Template
# Copy this file or service-level .env.example files to .env for local development.
# DO NOT commit actual secrets or credentials to version control.

# ==========================================
# Frontend Configuration (Vite)
# ==========================================
VITE_API_BASE_URL=http://localhost:5000/api

# ==========================================
# Backend Configuration (Node.js / Express)
# ==========================================
PORT=5000
NODE_ENV=development

# Database (Planned for future phase)
MONGODB_URI=mongodb://localhost:27017/kumbhmitra

# External APIs (Planned for future phase)
GOOGLE_MAPS_API_KEY=
AI_API_KEY=
