# Frontend Environment Variables Template
# Copy this file to .env and fill in your values.

# Backend REST API base URL
# Points to the Node/Express backend (default: localhost:5000)
VITE_API_BASE_URL=http://localhost:5000/api

# Set to 'false' to disable live backend API and always use local demo data
# Leave as 'true' (default) to attempt backend connection with graceful mock fallback
VITE_USE_API=true

# Google Maps Platform JavaScript API Key
# Provide your key here (or in frontend/.env) to enable live Google Maps 2D tiles
VITE_GOOGLE_MAPS_API_KEY=
